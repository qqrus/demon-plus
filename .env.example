# Copy to .env in the repository root. Run commands from that directory.
# Never commit .env. Values here are non-secret local examples.
DEMON_PLUS_LOG_LEVEL=INFO
DEMON_PLUS_DATA_DIR=data
DEMON_PLUS_ARTIFACTS_DIR=artifacts

# Evaluation protocol: cutoffs are the last observed day, before the forecast.
# Changing these values defines a different experiment.
DEMON_PLUS_ANALYSIS_START=2017-01-05
DEMON_PLUS_VALIDATION_CUTOFFS=["2018-03-31","2018-04-30","2018-05-31"]
DEMON_PLUS_HOLDOUT_CUTOFF=2018-06-30
DEMON_PLUS_TOP_CATEGORIES=10
DEMON_PLUS_MIN_ACTIVE_DAYS=60
